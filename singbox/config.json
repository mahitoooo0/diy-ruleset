  "providers": [
    {
      "tag": "P1",
      "type": "remote",
      "url": "https://train.suuwu.de/api/linkon?token=__REPLACE_WITH_NEW_P1_TOKEN__&protocol=anytls",
      "exclude": "节点|剩余|套餐|客服|官网",
      "path": "./source/proxy_provider_P1.json",
      "update_interval": "12h",
      "user_agent": "clash.meta/alpha/mihomo",
      "health_check": {
        "enabled": true,
        "url": "http://cp.cloudflare.com/generate_204",
        "interval": "10m",
        "timeout": "5s"
      }
    }
  ],
  "route": {
    "default_domain_resolver": "dns-direct",
    "rule_set": [
      {
        "type": "local",
        "tag": ["block", "direct", "proxy"],
        "format": "source",
        "path": "./source/{tag}.json"
      },
      {
        "type": "remote",
        "tag": ["Ads_AWAvenue", "AppleCN", "ChinaDomain", "ChinaIP", "Proxy"],
        "format": "binary",
        "url": "https://raw.githubusercontent.com/Repcz/Tool/X/sing-box/Rules/{tag}.srs",
        "update_interval": "3h",
        "path": "./source/rule_set/{tag}.srs"
      },
      {
        "type": "remote",
        "tag": ["google", "github", "telegram", "twitter", "tiktok", "youtube", "facebook", "microsoft", "onedrive", "apple", "googlefcm", "douyin", "bilibili"],
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/{tag}.srs",
        "update_interval": "3h",
        "path": "./source/rule_set/{tag}.srs"
      },
      {
        "type": "remote",
        "tag": ["reject", "webrtc", "google_ip", "twitter_ip", "telegram_ip", "private_ip", "ai"],
        "format": "binary",
