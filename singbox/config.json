{
  "$schema": "https://raw.githubusercontent.com/CHIZI-0618/sing-box/testing-ebpf/docs/schema.json",
  "log": {
    "disabled": false,
    "level": "warn",
    "output": "sing-box.log",
    "timestamp": true
  },
  "ntp": {
    "enabled": true,
    "server": "ntp.aliyun.com",
    "server_port": 123,
    "interval": "1d"
  },
  "experimental": {
    "urltest_unified_delay": true,
    "cache_file": {
      "enabled": true,
      "path": "cache.db",
      "store_fakeip": true,
      "store_rdrc": false
    },
    "clash_api": {
      "default_mode": "Rule",
      "external_controller": "127.0.0.1:9090",
      "secret": "__REPLACE_WITH_NEW_CLASH_API_SECRET__",
      "external_ui": "zashboard",
      "external_ui_download_url": "https://github.com/Zephyruso/zashboard/archive/refs/heads/gh-pages.zip"
    }
  },
  "services": [
    {
      "type": "api",
      "listen": "127.0.0.1",
      "listen_port": 9999,
      "secret": "__REPLACE_WITH_NEW_SERVICES_API_SECRET__",
      "dashboard": {
        "enabled": true,
        "path": "dashboard",
        "download_url": "https://github.com/SagerNet/sing-box-dashboard/archive/refs/heads/gh-pages.zip",
        "http_client": "s-download",
        "update_interval": "1d"
      }
    }
  ],
  "http_clients": [
    {
      "tag": "s-download",
      "detour": "📡 DNS出站"
    }
  ],
  "dns": {
    "servers": [
      {
        "type": "hosts",
        "tag": "hosts",
        "predefined": {
          "doh.pub": [
            "120.53.53.53",
            "1.12.12.12"
          ],
          "dns.alidns.com": [
            "223.5.5.5",
            "223.6.6.6"
          ],
          "cloudflare-dns.com": [
            "1.1.1.1",
            "1.0.0.1"
          ],
          "dns.google": [
            "8.8.8.8",
            "8.8.4.4"
          ]
        }
      },
      {
        "tag": "dns-proxy",
        "type": "group",
        "servers": [
          "cloudflare",
          "google"
        ]
      },
      {
        "tag": "dns-direct",
        "type": "group",
        "servers": [
          "tencent",
          "ali"
        ]
      },
      {
        "tag": "cloudflare",
        "type": "https",
        "server": "1.1.1.1",
        "detour": "📡 DNS出站"
      },
      {
        "tag": "google",
        "type": "https",
        "server": "8.8.8.8",
        "detour": "📡 DNS出站"
      },
      {
        "tag": "tencent",
        "type": "https",
        "server": "doh.pub",
        "domain_resolver": "hosts"
      },
      {
        "tag": "ali",
        "type": "https",
        "server": "dns.alidns.com",
        "domain_resolver": "hosts"
      },
      {
        "tag": "remote",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          { "clash_mode": "AllowAds", "invert": true },
          { "rule_set": ["block", "Ads_AWAvenue"] }
        ],
        "action": "reject"
      },
      { "clash_mode": "Direct", "action": "route", "server": "dns-direct" },
      { "clash_mode": "Global", "action": "route", "server": "dns-proxy" },
      {
        "domain_suffix": [
          "mtalk.google.com",
          "fcm.googleapis.com",
          "firebase.googleapis.com",
          "firebaseinstallations.googleapis.com",
          "fcmregistrations.googleapis.com",
          "android.clients.google.com",
          "device-provisioning.googleapis.com"
        ],
        "action": "route",
        "server": "dns-proxy"
      },
      { "rule_set": ["googlefcm"], "action": "route", "server": "dns-proxy" },
      { "rule_set": ["Ads_AWAvenue", "reject", "webrtc"], "action": "predefined", "rcode": "NXDOMAIN" },
      { "rule_set": ["direct", "AppleCN", "ChinaDomain"], "action": "route", "server": "dns-direct" },
      {
        "rule_set": ["google", "github", "ai", "facebook", "twitter", "telegram", "tiktok", "youtube", "proxy"],
        "query_type": ["A", "AAAA"],
        "action": "route",
        "server": "dns-proxy"
      },
      { "query_type": "PTR", "action": "reject" },
      { "query_type": ["SVCB", "HTTPS"], "action": "predefined", "rcode": "NOTIMP" },
      { "domain_regex": "^(\\d{1,3}\\.){3}\\d{1,3}$", "action": "reject" },
      { "domain": ["gn-cn"], "action": "route", "server": "dns-direct" },
      {
        "query_type": ["A", "AAAA"],
        "action": "evaluate",
        "server": "dns-proxy"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          { "rule_set": "ChinaIP", "match_response": true },
          { "ip_is_private": true, "match_response": true }
        ],
        "server": "dns-direct",
        "disable_cache": false
      },
      { "query_type": ["A", "AAAA"], "action": "respond" }
    ],
    "final": "dns-direct",
    "reverse_mapping": true,
    "optimistic": true,
    "strategy": "ipv4_only",
    "cache_capacity": 8192
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 7080
    },
    {
      "type": "ebpf",
      "tag": "ebpf-in",
      "redirect_address": [
        "127.128.0.0/9",
        "fd53:696e:672d:626f::/64"
      ],
      "dns_mode": "hijack",
      "bypass_rule_set": [
        "ChinaIP"
      ],
      "shared_network": {
        "enabled": true,
        "include_interface": [
          "wlan0",
          "wlan1",
          "rmnet_data0",
          "rmnet_data1"
        ]
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "type": "direct",
      "tcp_keep_alive": "5m",
      "tcp_keep_alive_interval": "45s",
      "tcp_keep_alive_count": 5
    },
    {
      "tag": "block",
      "type": "block"
    },
    {
      "tag": "📡 DNS出站",
      "type": "selector",
      "interrupt_exist_connections": true,
      "outbounds": [
        "⚡ 延迟最低",
        "🖐️ 手动选择",
        "🇺🇸 美国节点",
        "🇭🇰 香港节点",
        "🇸🇬 狮城节点",
        "🇯🇵 日本节点",
        "🇹🇼 台湾节点",
        "👨‍🦽 其他节点"
      ],
      "default": "⚡ 延迟最低"
    },
    {
